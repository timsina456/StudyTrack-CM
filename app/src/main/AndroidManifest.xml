<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately no INTERNET permission. StudyTrack is offline-first
        (spec section 32/43): everything works with zero network access.
        Voice input uses the system speech-recognition activity, which
        handles its own microphone permission — StudyTrack never touches
        RECORD_AUDIO directly.
    -->

    <application
        android:name=".StudyTrackApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.StudyTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
